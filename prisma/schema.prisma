generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String
  email     String   @unique
  password  String
  role      String   @default("user")
  createdAt DateTime @default(now())
}

model Team {
  id        String   @id @default(cuid())
  name      String
  country   String?
  logo      String?
  createdAt DateTime @default(now())
}

model Championship {
  id        String   @id @default(cuid())
  name      String
  country   String?
  season    String?
  createdAt DateTime @default(now())
}

model Match {
  id          String   @id @default(cuid())
  homeTeam    String
  awayTeam    String
  homeScore   Int?
  awayScore   Int?
  status      String   @default("scheduled")
  competition String?
  kickoff     DateTime
  createdAt   DateTime @default(now())
}

model Analysis {
  id        String   @id @default(cuid())
  title     String
  content   String
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

